<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Rayla Petal</Author>
    <Name>CoPose</Name>
    <Punchline>Pose together in GPose: either player can pose either character, live.</Punchline>
    <Description>Shared-control GPose scenes for Ktisis. One player hosts a session from inside the plugin and shares an invite code;
bone edits made by either player on either character are mirrored live on both clients. Requires Ktisis.</Description>
    <RepoUrl>https://github.com/RaylaPetal/gpose-couple</RepoUrl>
    <Tags>gpose;ktisis;posing;sync</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoPose.Protocol\CoPose.Protocol.csproj" />
    <ProjectReference Include="..\CoPose.Core\CoPose.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
  </ItemGroup>
</Project>
